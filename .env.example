# Copy this file to .env and fill in real values to enable LIVE AWS S3 calls
# for the Storage module. Without these, the server still runs fully —
# storage resources are just simulated in the local database instead.
#
# The account you use needs s3:CreateBucket / s3:DeleteBucket / s3:ListBuckets
# permissions. Never commit your real .env file.

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=ap-south-1

PORT=3000
